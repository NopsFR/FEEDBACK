{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FEEDBACK",
  "version": "0.1.0",
  "identifier": "app.feedback.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm build:pwa",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FEEDBACK",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0B0B0B",
        "visible": true,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: fbmedia: http://fbmedia.localhost https://fbmedia.localhost",
        "media-src": "'self' blob: fbmedia: http://fbmedia.localhost https://fbmedia.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost fbmedia: http://fbmedia.localhost https://fbmedia.localhost",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "FEEDBACK",
    "copyright": "FEEDBACK",
    "category": "Music",
    "shortDescription": "Music people repeat.",
    "longDescription": "FEEDBACK is a local-first player for the music and music videos you own. No account, no ads, no tracking.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      }
    },
    "resources": {
      "../dist-pwa/": "pwa/"
    }
  }
}